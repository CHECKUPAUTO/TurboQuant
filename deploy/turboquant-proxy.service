[Unit]
Description=TurboQuant Proxy — Ollama KV cache compression proxy
Documentation=https://github.com/CHECKUPAUTO/TurboQuant
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment="OLLAMA_HOST=http://127.0.0.1:11434"
Environment="TQ_REPORT_DIR=/var/log/turboquant"
Environment="TQ_PROXY_BIND=127.0.0.1:11435"
Environment="TQ_PROXY_UPSTREAM=127.0.0.1:11434"
Environment="RUST_LOG=info"
ExecStartPre=/bin/mkdir -p /var/log/turboquant
ExecStart=/opt/turboquant/bin/turboquant-daemon proxy
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=turboquant-proxy

[Install]
WantedBy=multi-user.target
